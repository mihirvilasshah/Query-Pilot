# =====================================================================================================
# QueryPilot environment variables.
#   Web app (Vercel / local):   copy the "WEB" block into apps/web/.env.local
#   Schema processor (Docker):  copy the "WORKER" block into .env (docker-compose reads it)
# NEVER commit real values. Only this example file is tracked by git.
# =====================================================================================================

# ----- WEB: Supabase (required) --------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API. The anon/publishable key is safe for the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the web app (used in email links). Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- WEB: server-only secrets (never prefix with NEXT_PUBLIC_) -----------------------------------
# Only needed to store per-user encrypted AI keys. Without it, QueryPilot works with server-level AI keys below.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# ----- WEB: AI (all optional - the app is fully usable without AI) ---------------------------------
# Default provider for users who have not chosen one: gemini | openrouter
AI_DEFAULT_PROVIDER=gemini
# Google AI Studio key (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter key: https://openrouter.ai/keys   (free models end in ":free")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Keep false: QueryPilot refuses non-free OpenRouter models unless you explicitly set true.
AI_ALLOW_PAID_MODELS=false

# ----- WORKER: schema-processor (separate Docker service; NOT on Vercel) ---------------------------
# Direct PostgreSQL connection (service role equivalent: bypasses RLS). Supabase -> Project Settings -> Database.
# Local Supabase CLI default: postgres://postgres:postgres@host.docker.internal:54322/postgres
DATABASE_URL=
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=schema-uploads
# Optional tuning
POLL_INTERVAL_SECONDS=3
STALE_JOB_SECONDS=600
MAX_FILE_BYTES=52428800
MAX_UNCOMPRESSED_BYTES=524288000
MAX_ZIP_ENTRIES=2000
# Read uploads from a local folder instead of Supabase Storage (development / tests only)
LOCAL_STORAGE_DIR=
# Optional /healthz endpoint for container orchestrators
HEALTH_PORT=
